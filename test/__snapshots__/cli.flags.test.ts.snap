exports[`help message 1`] = `
"Usage: envs

Manage .env files per worktree

Options:
  -h, --help.              Show this help message

Commands:
  init                     Create the .envs/ directory
  pull                     Read each worktree's .env into .envs/values.yml
  push                     Write defaults and .envs/values.yml into each worktree's .env
  lint                     Warn about insecure values and unprotected secret files
  edit                     Pull, edit .envs/values.yml, then push
  use                      Select the profile of the current worktree, or list them
  restore                  Restore values.yml to a history point
  history                  Manage the history
  config                   Read or change .envs/config.yml
  helpCommand              Show this help message
"
`;

